{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/transactions/[ticketId]/approve",
      "regex": "^/api/transactions/([^/]+?)/approve(?:/)?$",
      "routeKeys": {
        "nxtPticketId": "nxtPticketId"
      },
      "namedRegex": "^/api/transactions/(?<nxtPticketId>[^/]+?)/approve(?:/)?$"
    },
    {
      "page": "/api/transactions/[ticketId]/pickup",
      "regex": "^/api/transactions/([^/]+?)/pickup(?:/)?$",
      "routeKeys": {
        "nxtPticketId": "nxtPticketId"
      },
      "namedRegex": "^/api/transactions/(?<nxtPticketId>[^/]+?)/pickup(?:/)?$"
    },
    {
      "page": "/api/transactions/[ticketId]/return",
      "regex": "^/api/transactions/([^/]+?)/return(?:/)?$",
      "routeKeys": {
        "nxtPticketId": "nxtPticketId"
      },
      "namedRegex": "^/api/transactions/(?<nxtPticketId>[^/]+?)/return(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/supervisor",
      "regex": "^/supervisor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/supervisor(?:/)?$"
    },
    {
      "page": "/user",
      "regex": "^/user(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/user(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}